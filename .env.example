# Backend runtime
PORT=4000
API_BASE_PATH=/api

# Exact deployed frontend origin. Never use * in production.
CORS_ORIGIN=http://localhost:4000

# Required in production. Use a long, random secret.
JWT_SECRET=

# Use None for a Netlify frontend calling a separate Render API over HTTPS.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# Supabase Postgres connection string (Transaction pooler recommended)
# Example:
# postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Enable PG SSL mode for providers that require TLS.
# Keep true for Supabase.
PG_SSL=true

# Optional credentials for the protected destructive smoke test. Do not commit real values.
SMOKE_IDENTIFIER=
SMOKE_PASSWORD=
